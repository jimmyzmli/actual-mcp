# Actual Budget MCP Server Configuration

# MCP HTTP Transport Bind Host & Port
HOST=127.0.0.1,100.66.140.23
PORT=9991

# Disable OAuth2 authentication on HTTP transport (defaults to false)
# When set to true or started with --no-auth, bearer token is not required.
NO_AUTH=false

# OAuth2 Authentication Credentials (required if NO_AUTH is false)
OAUTH_CLIENT_ID=gemini-spark
OAUTH_CLIENT_SECRET=your_oauth_client_secret
ALLOWED_REDIRECT_DOMAINS=oauth-redirect.googleusercontent.com,vertexaisearch.cloud.google.com

# PocketBase Receipts Integration
PB_UPLOAD_BASE_URL=https://pb.lzn.ca
PB_USER=actual_orch@lizen.org
PB_PASSWORD=your_pocketbase_password

# Actual Budget Server Configuration
ACTUAL_SERVER_URL=https://budget.lzn.ca
ACTUAL_PASSWORD=your_actual_password
ACTUAL_SYNC_ID=your_sync_id
ACTUAL_ENCRYPTION_PASSWORD=your_encryption_password
