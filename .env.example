# Actual Budget MCP Server Configuration

# MCP HTTP Transport Port (when running with --port)
PORT=3000

# Disable OAuth2 authentication on HTTP transport (defaults to false)
# When set to true or started with --no-auth, bearer token is not required.
NO_AUTH=false

# Actual Budget Server Configuration
# Alternatively, configuration can be read from ~/.actualrc.json
ACTUAL_SERVER_URL=http://localhost:5006
ACTUAL_PASSWORD=your_actual_server_password
ACTUAL_SYNC_ID=your_budget_sync_id
ACTUAL_ENCRYPTION_PASSWORD=your_e2e_encryption_password_if_enabled

# Storage & Paths (optional)
# ACTUAL_DATA_DIR=~/.actual-data
# ACTUAL_RC_PATH=~/.actualrc.json
# ACTUAL_SKILL_PATH=

# OAuth2 Authentication Credentials (required if NO_AUTH is false)
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
ALLOWED_REDIRECT_DOMAINS=oauth-redirect.googleusercontent.com,localhost
